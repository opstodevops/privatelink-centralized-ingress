        <mxCell id="note1" value="Without CloudFront, the ALB is internet facing and users connect to it directly (step 2 starts at the ALB)." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#545B64;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="150" y="380" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="Each subnet type exists once per Availability Zone. With the firewall, traffic between the ALB subnet and the endpoint subnet in the same AZ is routed through that AZ's firewall endpoint in both directions." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#545B64;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="600" y="100" width="350" height="60" as="geometry" />
        </mxCell>
